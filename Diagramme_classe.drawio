  <diagram name="Page-1" id="BkV-S0HyXc4tdkji09xz">
    <mxGraphModel dx="2887" dy="1444" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam monochrome false\nskinparam roundcorner 10\nskinparam shadowing true\n\n&#39; ================= ENUMS =================\nenum Role {\n    INFIRMIER\n    GENERALISTE\n    SPECIALISTE\n    ADMIN\n}\n\nenum PrioriteExpertise {\n    URGENTE\n    NORMALE\n    NON_URGENTE\n}\n\nenum StatutConsultation {\n    EN_ATTENTE\n    EN_COURS\n    EN_ATTENTE_AVIS_SPECIALISTE\n    TERMINEE\n}\n\nenum StatutCreneau {\n    DISPONIBLE\n    RESERVE\n    ARCHIVE\n}\n\nenum StatutExpertise {\n    EN_ATTENTE\n    TERMINEE\n    REFUSEE\n}\n\nenum SpecialiteMedicale {\n    CARDIOLOGIE\n    PNEUMOLOGIE\n    NEUROLOGIE\n    GASTRO_ENTEROLOGIE\n    ENDOCRINOLOGIE\n    DERMATOLOGIE\n    RHUMATOLOGIE\n    PSYCHIATRIE\n    NEPHROLOGIE\n    ORTHOPEDIE\n}\n\n&#39; ================= ENTITIES =================\n\nabstract class Utilisateur {\n    - id : Long\n    - nom : String\n    - prenom : String\n    - email : String\n    - motDePasse : String\n    - telephone : String\n    - role : Role\n    - actif : boolean\n    + getNomComplet() : String\n}\n\nclass Infirmier {\n    - matriculePro : String\n}\n\nclass MedecinGeneraliste {\n    - matriculeOrdre : String\n}\n\nclass MedecinSpecialiste {\n    - specialite : SpecialiteMedicale\n    - tarifExpertise : Double\n    - dureeConsultationMin : Integer = 30\n}\n\nclass Patient {\n    - id : Long\n    - nom : String\n    - prenom : String\n    - dateNaissance : LocalDate\n    - numSecuriteSociale : String\n    - telephone : String\n    - adresse : String\n    - mutuelle : String\n    - antecedents : String\n    - allergies : String\n    - traitementsEnCours : String\n    - enAttente : boolean\n    - dateEnregistrement : LocalDateTime\n}\n\nclass SigneVital {\n    - id : Long\n    - tensionArterielle : String\n    - frequenceCardiaque : Integer\n    - temperatureCorporelle : Double\n    - frequenceRespiratoire : Integer\n    - poidsKg : Double\n    - tailleCm : Double\n    - datePrise : LocalDateTime\n}\n\nclass Consultation {\n    - id : Long\n    - dateConsultation : LocalDateTime\n    - motif : String\n    - examenClinique : String\n    - observations : String\n    - diagnostic : String\n    - ordonnance : String\n    - statut : StatutConsultation\n    - coutBase : Double = 150.0\n    + calculerCoutTotal() : Double\n}\n\nclass ActeTechnique {\n    - id : Long\n    - libelle : String\n    - code : String\n    - tarif : Double\n    - description : String\n}\n\nclass Creneau {\n    - id : Long\n    - dateHeureDebut : LocalDateTime\n    - dateHeureFin : LocalDateTime\n    - statut : StatutCreneau\n}\n\nclass DemandeTeleExpertise {\n    - id : Long\n    - dateDemande : LocalDateTime\n    - question : String\n    - donneesAnalyses : String\n    - priorite : PrioriteExpertise\n    - statut : StatutExpertise\n    - avisExpert : String\n    - recommandations : String\n    - dateReponse : LocalDateTime\n}\n\n&#39; ================= RELATIONS =================\n\nUtilisateur &lt;|-- Infirmier\nUtilisateur &lt;|-- MedecinGeneraliste\nUtilisateur &lt;|-- MedecinSpecialiste\n\nPatient \&quot;1\&quot; *-- \&quot;0..*\&quot; SigneVital : mesure &gt;\nInfirmier \&quot;1\&quot; --&gt; \&quot;0..*\&quot; SigneVital : enregistre &gt;\n\nPatient \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; Consultation : concerne &lt;\nMedecinGeneraliste \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Consultation : effectue &gt;\n\nConsultation \&quot;1\&quot; *-- \&quot;0..*\&quot; ActeTechnique : contient &gt;\n\nConsultation \&quot;1\&quot; o-- \&quot;0..1\&quot; DemandeTeleExpertise : initie &gt;\nMedecinSpecialiste \&quot;1\&quot; --&gt; \&quot;0..*\&quot; DemandeTeleExpertise : traite &gt;\n\nMedecinSpecialiste \&quot;1\&quot; *-- \&quot;0..*\&quot; Creneau : planifie &gt;\nDemandeTeleExpertise \&quot;0..1\&quot; --&gt; \&quot;1\&quot; Creneau : reserve &gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="zFkcH-QuccSaTAzq2gAP-1">
